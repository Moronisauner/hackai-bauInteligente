# Conexão com o Postgres da POC (vide infra/docker-compose.yml)
DATABASE_URL=postgres://hackai:hackai@localhost:5432/hackai?sslmode=disable

# Data de referência da POC — TODA regra temporal usa esta data (PRD §8).
# Formato obrigatório: YYYY-MM-DD
POC_REFERENCE_DATE=2025-01-01

# Porta HTTP do servidor (opcional, default :8080)
HTTP_PORT=:8080

# Provedor de LLM do assistente de planejamento (API compatível com OpenAI).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Chave do provedor (segredo). Em dev, coloque no .env da raiz (não versionado),
# que o mise carrega automaticamente. Sem ela, o endpoint do assistente falha.
LLM_API_KEY=
